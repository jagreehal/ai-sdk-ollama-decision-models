{
  "name": "ai-sdk-ollama-decision-models",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ollama decision models (nimble, tev1) through ai-sdk-ollama: ticket triage, and letting the model judge while code decides.",
  "scripts": {
    "triage": "tsx src/triage.ts",
    "bench": "tsx src/bench.ts",
    "support": "tsx src/support/run.ts",
    "eval-judgments": "tsx src/support/eval.ts",
    "test": "tsx --test src/support/*.test.ts",
    "check": "tsc --noEmit",
    "llm-decides": "tsx src/support/llm-decides.ts"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.83",
    "ai": "7.0.181",
    "ai-sdk-ollama": "4.6.3"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
